# Filling in real values later.
# .env.local gitignored — never commit.

# ==========================================
# Supabase (DB)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...your-anon-key

# ==========================================
# Prisma (DB 직접 연결 — 스키마 자동 관리용)
# ==========================================
# Supabase 대시보드 → Settings → Database → Connection string (URI)
# Pooler (런타임 쿼리용 / pgbouncer)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (Prisma migrate 용 — pooler 우회)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ==========================================
# LLM Provider
# ==========================================
# OpenAI (현재 사용 중)
OPENAI_API_KEY=sk-proj-...
# Anthropic Claude (예정)
# ANTHROPIC_API_KEY=sk-ant-...

# ==========================================
# Frontend -> Backend
# ==========================================
# Where the Next.js frontend should call the FastAPI backend.
# Local dev: http://localhost:15501
# Production: your deployed backend URL
NEXT_PUBLIC_API_URL=http://localhost:15501

# ==========================================
# Vercel Cron (Supabase keepalive)
# ==========================================
# Vercel cron이 /api/cron/keepalive를 부를 때 Authorization 헤더에 실리는 값.
# 임의 문자열(예: openssl rand -hex 32). Vercel 프로젝트 환경변수에만 등록하면 됨 —
# 로컬에는 불필요 (없으면 인증 우회).
CRON_SECRET=
